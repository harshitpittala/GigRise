# apps/web — subset of the full list in the repo-root .env.example
# (PROJECT_SETUP.md §5). Next.js reads env vars from this app's OWN
# directory, not from the monorepo root, so this file exists to make
# local development actually work, not just to document the variables.
#
# Copy to .env.local in this directory and fill in real values — never
# commit .env.local.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_REALTIME_URL=
