# apps/admin — subset of the full list in the repo-root .env.example
# (PROJECT_SETUP.md §5). Same reasoning as apps/web/.env.example: Next.js
# reads env vars from this app's own directory, not the monorepo root.
#
# Copy to .env.local in this directory and fill in real values — never
# commit .env.local.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_REALTIME_URL=
